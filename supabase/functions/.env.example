# Segredos das Edge Functions — NUNCA expor no frontend.
# Produção: supabase secrets set NOME=valor   |   Local: supabase functions serve --env-file supabase/functions/.env
GOOGLE_MAPS_API_KEY=          # Places API (New) + Geocoding API
BRAVE_SEARCH_API_KEY=         # ou GOOGLE_CSE_API_KEY + GOOGLE_CSE_CX
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ALLOWED_ORIGINS=*             # ex.: https://app.seudominio.com.br
SITE_URL=http://localhost:5173
CRON_SECRET=                  # para o monitoramento agendado de sites
# Limites (opcionais): LIMIT_GOOGLE_PLACES_PER_MINUTE, LIMIT_GOOGLE_PLACES_PER_DAY, LIMIT_ANTHROPIC_PER_DAY, ...
