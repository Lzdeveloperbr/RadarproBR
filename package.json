    "@dnd-kit/utilities": "^3.2.2",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "@vis.gl/react-google-maps": "^1.10.2",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "sonner": "^2.0.8",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
